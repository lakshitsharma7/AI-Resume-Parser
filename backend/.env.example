# ==============================================================================
# AI Resume Parser - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize as needed:
#   copy .env.example .env
# ==============================================================================

# Application Metadata & Debugging
APP_NAME="AI Resume Parser"
APP_VERSION="1.0.0"
DEBUG=false

# Local AI Engine (Ollama)
# Requires Ollama running locally: https://ollama.ai
OLLAMA_HOST=http://127.0.0.1:11434
# Lightweight quantized model recommended for 8 GB RAM machines
OLLAMA_MODEL=phi3:mini
# Inference socket timeout in seconds
OLLAMA_TIMEOUT=25.0

# OCR Engine (Tesseract)
# Leave empty if tesseract is already in system PATH.
# Example Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
# Example Linux path: /usr/bin/tesseract
TESSERACT_CMD=

# File Upload & Storage Limits
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=25
# Whether to retain parsed files permanently on disk (default is false for zero retention)
STORE_UPLOADED_FILES_PERMANENTLY=false

# JSON Forwarding & SSRF Protection
# Maximum timeout in seconds when dispatching JSON to destination APIs
FORWARD_REQUEST_TIMEOUT=15.0
# Set to 'true' ONLY in local development or test suites to permit forwarding to 127.0.0.1/localhost.
# In production, KEEP THIS FALSE to strictly block SSRF attacks against private networks and cloud metadata.
ALLOW_LOCAL_DESTINATIONS=false

